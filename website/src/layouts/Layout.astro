---
import type { Copy, Locale } from '../i18n'
import { isDownloadReady, release } from '../data/site'
import { languages } from '../i18n'
import themeInit from '../scripts/theme-init.js?raw'
import '../styles/global.css'

interface Props {
  locale: Locale
  copy: Copy
}
const { locale, copy } = Astro.props
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined
---

<!doctype html>
<html lang={locale} class="scroll-pt-[calc(var(--header-height)+24px)] [scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <meta name="color-scheme" content="light dark" />
    {!isDownloadReady(release.macDownloadUrl) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/Lexend-600.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/InterTight-400.ttf" as="font" type="font/ttf" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site &&
      languages.map((language) => (
        <link rel="alternate" hreflang={language.locale} href={new URL(language.path, Astro.site)} />
      ))}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={Astro.site} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <title>{copy.title}</title>
    <script is:inline set:html={themeInit} />
  </head>
  <body id="top" class="bg-canvas font-copy text-[18px] leading-[1.6] text-text antialiased">
    <a
      class="fixed top-2 left-4 z-100 -translate-y-[200%] rounded-control bg-text px-6 py-3 text-canvas focus:translate-y-0"
      href="#main"
    >
      {copy.nav.skip}
    </a>
    <slot />
    <script>
      import '../scripts/interactions'
      import '../scripts/motion'
    </script>
  </body>
</html>
