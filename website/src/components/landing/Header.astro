---
import type { Copy, Locale } from '../../i18n'
import { languages } from '../../i18n'
import HeaderPreferences from './HeaderPreferences.astro'
import Mascot from './Mascot.astro'

interface Props {
  copy: Copy
  locale: Locale
}
const { copy, locale } = Astro.props
---

<div class="relative hidden h-0 js:block md:h-30" aria-hidden="true">
  <span class="pointer-events-none absolute top-2 size-px md:top-24" data-navigation-sentinel></span>
</div>
<header
  data-site-header
  class:list={[
    'sticky top-0 z-30 w-full bg-transparent transition-[background,box-shadow] duration-150 ease-[ease] compact:bg-canvas compact:shadow-[0_1px_0_color-mix(in_srgb,var(--color-text)_8%,transparent)]',
    'max-[767px]:supports-[backdrop-filter:blur(24px)]:compact:bg-canvas/55 max-[767px]:supports-[backdrop-filter:blur(24px)]:compact:backdrop-blur-xl max-[767px]:supports-[backdrop-filter:blur(24px)]:compact:backdrop-saturate-180',
    'md:relative md:left-1/2 md:max-w-full md:-translate-x-1/2 md:border md:border-transparent md:px-[calc(clamp(24px,5vw,96px)-1px)] md:py-9.25 md:transition-[top,width,max-width,padding,border-radius,border-color,background] md:duration-320 md:ease-[cubic-bezier(.22,1,.36,1)] md:js:fixed',
    'md:compact:top-4 md:compact:w-[calc(100%-32px)] md:compact:max-w-190 md:compact:rounded-full md:compact:border-line md:compact:px-6 md:compact:py-2 md:compact:shadow-none',
    'md:supports-[backdrop-filter:blur(20px)]:compact:bg-canvas/72 md:supports-[backdrop-filter:blur(20px)]:compact:backdrop-blur-[20px] md:supports-[backdrop-filter:blur(20px)]:compact:backdrop-saturate-140',
    'reduce-transparency:compact:bg-canvas! reduce-transparency:compact:backdrop-filter-none!',
  ]}
>
  <div class="flex min-h-15 w-full items-center justify-between gap-7 px-4 md:min-h-11 md:gap-6 md:px-0">
    <a
      class="group/brand inline-flex shrink-0 items-center gap-2.5 font-heading text-[15px] leading-none font-semibold tracking-[-0.06em] md:gap-2 md:text-[25px]"
      href={languages.find((language) => language.locale === locale)?.path}
      aria-label="Mumu TV"
    >
      <Mascot class="w-9 transition-transform duration-240 ease-[ease] group-hover/brand:-rotate-10 md:w-12" />
      <span class="font-footer">Mumu TV</span>
    </a>
    <nav
      class="flex items-center gap-3.5 text-[0.9375rem] font-medium whitespace-nowrap md:gap-4"
      id="site-navigation"
      aria-label={copy.nav.menu}
    >
      <HeaderPreferences copy={copy} locale={locale} id="desktop" />
      <a
        href="#download"
        class="hidden min-h-11 items-center justify-center gap-2.5 rounded-full border border-transparent bg-text px-5 py-2.5 text-center text-[0.9375rem] leading-[1.35] font-semibold text-canvas transition-[transform,background,box-shadow] duration-180 ease-[ease] hover:-translate-y-0.75 active:translate-y-0 active:scale-[.98] md:inline-flex"
      >
        {copy.nav.download}
      </a>
    </nav>
  </div>
</header>
