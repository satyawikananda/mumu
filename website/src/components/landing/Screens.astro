---
import type { Copy } from '../../i18n'
import { Maximize2, X } from '@lucide/astro'
import { Image } from 'astro:assets'
import discover from '../../assets/screenshots/discover.webp'
import favorites from '../../assets/screenshots/favorites.webp'
import playlist from '../../assets/screenshots/add-playlist.webp'

interface Props {
  copy: Copy
}
const { copy } = Astro.props
const screens = [
  { image: discover, alt: copy.alt.discover, id: 'discover' },
  { image: playlist, alt: copy.alt.playlist, id: 'playlist' },
  { image: favorites, alt: copy.alt.favorites, id: 'favorites' },
]
---

<section
  class="mx-auto w-[min(1240px,calc(100%-96px))] py-section max-[1050px]:w-[calc(100%-64px)] max-[760px]:w-[calc(100%-40px)]"
  id="features"
  aria-labelledby="features-title"
>
  <div
    class="mb-12 grid grid-cols-[1.3fr_1fr] items-end gap-20 max-[1050px]:gap-10 max-[760px]:mb-8 max-[760px]:grid-cols-1 max-[760px]:gap-6"
    data-reveal
  >
    <h2 id="features-title">{copy.features.title}</h2>
    <p class="max-w-100 justify-self-end text-[1.1875rem] text-secondary max-[760px]:justify-self-start max-[760px]:text-lg">
      {copy.features.body}
    </p>
  </div>
  <div
    class="mb-8 flex flex-wrap gap-8 border-b border-line no-js:hidden max-[760px]:gap-x-5.5 max-[760px]:gap-y-2"
    role="tablist"
    aria-label={copy.features.gallery}
  >
    {screens.map((screen, index) => (
      <button
        class="relative py-4 text-start text-base after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:origin-left after:scale-x-0 after:bg-action after:transition-transform after:duration-220 after:ease-[ease] after:content-[''] hover:after:scale-x-100 aria-selected:font-semibold aria-selected:text-action-text aria-selected:after:scale-x-100 max-[760px]:py-3 max-[760px]:text-[0.9375rem]"
        id={`tab-${screen.id}`}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${screen.id}`}
        tabindex={index === 0 ? 0 : -1}
        data-screen={screen.id}
      >
        {copy.features.tabs[index]}
      </button>
    ))}
  </div>
  <div>
    {screens.map((screen, index) => (
      <div
        id={`panel-${screen.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${screen.id}`}
        hidden={index !== 0}
        tabindex="0"
      >
        <div
          class="relative overflow-hidden rounded-screen border border-line max-[760px]:rounded-[10px]"
          data-screenshot-wrap
        >
          <Image
            src={screen.image}
            alt={screen.alt}
            widths={[600, 1000, 1600, 2000]}
            sizes="(max-width: 700px) 92vw, 86vw"
            class="aspect-2940/1840 w-full bg-[#09090b] object-contain max-[760px]:rounded-[10px]"
            loading="lazy"
          />
          <button
            class="absolute right-4 bottom-4 inline-flex size-11 items-center justify-center rounded-control border border-line bg-canvas p-2.5 text-text hover:bg-raised active:scale-[.94] no-js:hidden"
            data-expand={screen.id}
            aria-label={copy.features.screenshot}
          >
            <Maximize2 size={20} aria-hidden="true" />
          </button>
        </div>
        <p class="mt-5 text-base max-[760px]:text-[0.9375rem]">{copy.features.captions[index]}</p>
      </div>
    ))}
  </div>
  <p class="mt-2 text-sm leading-[1.55] text-secondary">{copy.features.community}</p>
  <dialog
    class="m-auto max-h-[94dvh] w-[min(96vw,1600px)] max-w-[96vw] overflow-auto rounded-screen border border-line bg-surface p-0 backdrop:bg-black/80"
    aria-label={copy.features.screenshot}
    data-screenshot-dialog
    data-lenis-prevent
  >
    <button
      class="fixed top-4 right-4 z-1 inline-flex size-11 items-center justify-center rounded-control border border-line bg-canvas p-2.5 text-text hover:bg-raised active:scale-[.94]"
      data-dialog-close
      aria-label={copy.features.close}
    >
      <X size={24} aria-hidden="true" />
    </button>
    <img class="w-full" data-dialog-image width="2940" height="1840" alt="" />
  </dialog>
</section>
